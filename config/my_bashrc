# 本机（容器）使用的 IP 地址
export ROS_IP=192.168.100.100

# ROS Master 节点的 URI 地址
export ROS_MASTER_URI=http://192.168.100.99:11311

# 配置代理
# export my_proxy=http://192.168.100.251:7890

export http_proxy=$my_proxy
export https_proxy=$my_proxy

# 自动检测并载入编译好的 ROS 工作空间环境变量
if [ -f "/home/ubuntu/catkin_ws/devel/setup.bash" ]; then
    source "/home/ubuntu/catkin_ws/devel/setup.bash"
fi

