FROM tiryoh/ros-desktop-vnc:noetic-20260426T0516

# 创建自定义 supervisor 配置目录，并修改主配置文件引入该目录下的所有 .conf 文件
RUN mkdir -p /etc/supervisor/custom.d && \
    sed -i 's|files = /etc/supervisor/conf.d/\*\.conf|files = /etc/supervisor/conf.d/*.conf /etc/supervisor/custom.d/*.conf|g' /etc/supervisor/supervisord.conf

# 将 ROS 官方源替换为清华镜像源，并从 Ubuntu 密钥服务器获取 ROS GPG 秘钥，安装 mavros 包
RUN --mount=type=bind,source=./debs,target=/tmp/debs \
    apt-get update && apt-get install -y curl gnupg2 && \
    apt-get update && \
    apt-get install -y ros-noetic-mavros ros-noetic-mavros-extras  libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-good1.0-dev \
    libgstrtspserver-1.0-dev \
    /tmp/debs/*.deb \
    && rm -rf /var/lib/apt/lists/*
    
# 安装mavros要求的地形库
WORKDIR /tmp
RUN wget https://raw.githubusercontent.com/mavlink/mavros/master/mavros/scripts/install_geographiclib_datasets.sh \
    && chmod +x ./install_geographiclib_datasets.sh &&  ./install_geographiclib_datasets.sh && rm -rf ./install_geographiclib_datasets.sh

WORKDIR /

# 拷贝并设置自定义的入口脚本，用于在启动时修正挂载目录权限 (放置在后部防止缓存失效导致重新下载安装依赖包)
COPY custom_entrypoint.sh /custom_entrypoint.sh
RUN chmod +x /custom_entrypoint.sh

WORKDIR /home/ubuntu
ENTRYPOINT [ "/custom_entrypoint.sh" ]